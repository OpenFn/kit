{
  "name": "@openfn/kit",
  "version": "1.0.0",
  "private": true,
  "description": "Packages to support OpenFn v2",
  "scripts": {
    "build": "pnpm run clean && pnpm -r --filter=./packages/* run build",
    "clean:local": "rimraf dist/**/*",
    "clean": "rimraf packages/*/dist",
    "export": "sh scripts/export.sh",
    "format": "prettier --write packages/*/src",
    "generate-slack-report": "node ./scripts/slack-publish-message.js",
    "install:global": "rimraf dist && pnpm build && pnpm run pack && node ./build/install-global.js",
    "install:openfnx": "pnpm install:global",
    "pack:local": "pnpm run pack && node ./build/pack-local.js",
    "pack": "pnpm -r run pack",
    "publish:new": "node scripts/publish-new.mjs",
    "test:format": "prettier --check packages/*/src",
    "test:integration": "pnpm -r --filter=./integration-tests/* run test",
    "test:legacy": "pnpm -C integration-tests/legacy-deploy run test",
    "test:types": "pnpm -r --filter=./packages/* run test:types",
    "test": "pnpm -r --filter=./packages/* run test",
    "trust:all": "node scripts/trust-all.mjs",
    "trust": "node scripts/trust.mjs",
    "_typesync": "pnpm exec typesync && pnpm -r exec typesync && pnpm install"
  },
  "keywords": [],
  "author": "Open Function Group",
  "license": "ISC",
  "devDependencies": {
    "@changesets/cli": "^2.30.0",
    "@slack/web-api": "^7.16.0",
    "@swc-node/register": "^1.11.1",
    "@types/gunzip-maybe": "^1.4.3",
    "@types/semver": "~7.5.8",
    "@types/tar-stream": "^2.2.3",
    "gunzip-maybe": "^1.4.2",
    "prettier": "^2.8.8",
    "rimraf": "^6.1.3",
    "semver": "^7.7.4",
    "tar-stream": "^3.1.8",
    "yargs": "^17.7.2"
  },
  "packageManager": "pnpm@12.6.0+sha512.3ef68f951cb111ac204b4a5a16f0b2ddf0da56a96e0413e81d855d9f0b55ef926714709028e1cd00c405c2c5fb7b9e8ec4dc46777c805d0373c2f2ff00fd20ec"
}
